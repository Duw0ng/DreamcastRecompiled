+set "RC=!ERRORLEVEL!"
+echo.
+echo [INFO] DreamcastRecomp %DCR_VERSION% termino con RC=!RC!.
+if "!RC!"=="130" echo [INFO] RC=130 = cierre manual de la ventana.
+exit /b !RC!
+
+:reuse_existing
