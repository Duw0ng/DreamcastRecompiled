-:usage_ok
-call :usage
-exit /b 0
+@echo off
+setlocal EnableExtensions EnableDelayedExpansion
+cd /d "%~dp0"
+
+set "DCR_VERSION=v0.1.1 Official"
+set "PERF=0"
+set "DEBUG=0"
+set "PVR_PROFILE=0"
+set "SOFTWARE=0"
+set "RENDERER=AUTO"
+set "RENDERER_EXPLICIT=0"
+set "NO_AUDIO=0"
+set "CLEAN=0"
+set "NOPAUSE=0"
+set "REUSE=0"
+
+if "%~1"=="" goto :usage
+if /I "%~1"=="--help" goto :usage_ok
+if /I "%~1"=="-h" goto :usage_ok
+
+set "DISC=%~f1"
+shift
+
+:parse_args
+if "%~1"=="" goto :args_done
+set "ARG=%~1"
+
+if /I "!ARG!"=="--renderer" goto :parse_renderer_value
+if /I "!ARG:~0,11!"=="--renderer=" (
+  set "RENDERER=!ARG:~11!"
+  set "RENDERER_EXPLICIT=1"
+  shift
+  goto :parse_args
+)
+if /I "!ARG:~0,6!"=="--gpu=" (
+  set "RENDERER=!ARG:~6!"
+  set "RENDERER_EXPLICIT=1"
+  shift
+  goto :parse_args
+)
+
+if /I "!ARG!"=="--perf" (
+  set "PERF=1"
+) else if /I "!ARG!"=="--debug" (
+  set "DEBUG=1"
+) else if /I "!ARG!"=="--profile" (
+  set "PVR_PROFILE=1"
+) else if /I "!ARG!"=="--software" (
+  set "SOFTWARE=1"
+  set "RENDERER=software"
+  set "RENDERER_EXPLICIT=1"
+) else if /I "!ARG!"=="--gpu" (
+  set "RENDERER=dx11"
+  set "RENDERER_EXPLICIT=1"
+) else if /I "!ARG!"=="--no-audio" (
+  set "NO_AUDIO=1"
+) else if /I "!ARG!"=="--clean" (
+  set "CLEAN=1"
+) else if /I "!ARG!"=="--no-pause" (
+  set "NOPAUSE=1"
+) else if /I "!ARG!"=="--reuse" (
+  set "REUSE=1"
+) else if /I "!ARG!"=="--no-recompile" (
+  set "REUSE=1"
+) else if /I "!ARG!"=="--help" (
+  goto :usage_ok
+) else if /I "!ARG!"=="-h" (
+  goto :usage_ok
+) else (
+  echo [ERROR] Opcion desconocida: %~1
+  echo.
+  goto :usage
+)
+shift
+goto :parse_args
+
+:parse_renderer_value
+shift
+if "%~1"=="" (
+  echo [ERROR] --renderer requiere un backend.
+  echo [INFO] Disponibles hoy: auto, dx11, software.
+  exit /b 1
+)
+set "RENDERER=%~1"
+set "RENDERER_EXPLICIT=1"
+shift
+goto :parse_args
+
+:args_done
+rem Normaliza aliases de renderer. Solo DX11 esta implementado como backend GPU hoy.
+if /I "!RENDERER!"=="AUTO" set "RENDERER=auto"
+if /I "!RENDERER!"=="D3D11" set "RENDERER=dx11"
+if /I "!RENDERER!"=="DIRECT3D11" set "RENDERER=dx11"
+if /I "!RENDERER!"=="DIRECTX11" set "RENDERER=dx11"
+if /I "!RENDERER!"=="DX11" set "RENDERER=dx11"
+if /I "!RENDERER!"=="SW" set "RENDERER=software"
+if /I "!RENDERER!"=="CPU" set "RENDERER=software"
+if /I "!RENDERER!"=="SOFTWARE" set "RENDERER=software"
+if /I "!RENDERER!"=="D3D12" set "RENDERER=dx12"
+if /I "!RENDERER!"=="DIRECT3D12" set "RENDERER=dx12"
+if /I "!RENDERER!"=="DIRECTX12" set "RENDERER=dx12"
+if /I "!RENDERER!"=="D3D10" set "RENDERER=dx10"
+if /I "!RENDERER!"=="DIRECT3D10" set "RENDERER=dx10"
+if /I "!RENDERER!"=="DIRECTX10" set "RENDERER=dx10"
+if /I "!RENDERER!"=="D3D9" set "RENDERER=dx9"
+if /I "!RENDERER!"=="DIRECT3D9" set "RENDERER=dx9"
+if /I "!RENDERER!"=="DIRECTX9" set "RENDERER=dx9"
+if /I "!RENDERER!"=="VK" set "RENDERER=vulkan"
+
+if /I "!RENDERER!"=="vulkan" goto :renderer_not_implemented
+if /I "!RENDERER!"=="dx12" goto :renderer_not_implemented
+if /I "!RENDERER!"=="dx10" goto :renderer_not_implemented
+if /I "!RENDERER!"=="dx9" goto :renderer_not_implemented
+if /I not "!RENDERER!"=="auto" if /I not "!RENDERER!"=="dx11" if /I not "!RENDERER!"=="software" (
+  echo [ERROR] Renderer desconocido: !RENDERER!
+  echo [INFO] Disponibles hoy: auto, dx11, software.
+  echo [INFO] Reservados para futuros backends: vulkan, dx12, dx10, dx9.
+  exit /b 1
+)
+if not exist "%DISC%" (
+  echo [ERROR] No encuentro el juego: "%DISC%"
+  exit /b 1
+)
+
+where cmake >nul 2>nul
+if errorlevel 1 (
+  echo [ERROR] CMake no esta disponible en PATH.
+  echo [INFO] Instala Visual Studio 2022 o Build Tools con "Desktop development with C++" y CMake.
+  exit /b 2
+)
+
+set "OUT=generated\official_v0.1.1"
+set "CPP=%OUT%\cpp"
+set "CB=_cb_v0.1.1"
+set "PADARG="
+if exist "profiles\controller_profile.ini" (
+  set "PADARG=--controller-profile=profiles\controller_profile.ini"
+)
+
+if "%REUSE%"=="1" goto :reuse_existing
+
+if "%CLEAN%"=="1" (
+  echo [CLEAN] Eliminando cache de la release oficial...
