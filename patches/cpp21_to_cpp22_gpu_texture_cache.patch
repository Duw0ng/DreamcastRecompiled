+  --mode=auto ^
+  --boot-out="%OUT%\BOOT.BIN" ^
+  --combined-out="%OUT%\BOOTSTRAP.BIN"
+if errorlevel 1 exit /b 4
+
+echo.
+echo [4/6] Recompilando closure SH-4...
