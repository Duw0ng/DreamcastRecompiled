+void pvr_yuv_convert_macroblock_420(DCRuntime& runtime, std::uint32_t src,
+                                    std::size_t dst_base, std::uint32_t mb_index,
+                                    std::uint32_t mb_width) {
+    // PVR YUV420 macroblock input is U(8x8), V(8x8), then Y as four 8x8
+    // quadrants (TL, TR, BL, BR): 64 + 64 + 256 = 384 bytes.
+    const std::uint32_t mb_x = mb_index % mb_width;
+    const std::uint32_t mb_y = mb_index / mb_width;
+    const std::uint32_t width_px = mb_width * 16u;
+    const std::size_t stride_bytes = static_cast<std::size_t>(width_px) * 2u;
+    for (std::uint32_t y = 0u; y < 16u; ++y) {
+        for (std::uint32_t x = 0u; x < 16u; x += 2u) {
+            const std::uint32_t uv_index = (y >> 1u) * 8u + (x >> 1u);
+            const std::uint8_t u = dc_read8(runtime, src + uv_index);
+            const std::uint8_t v = dc_read8(runtime, src + 64u + uv_index);
+            auto y_index = [y](std::uint32_t px) -> std::uint32_t {
+                const std::uint32_t quadrant = (y >= 8u ? 2u : 0u) + (px >= 8u ? 1u : 0u);
+                return 128u + quadrant * 64u + (y & 7u) * 8u + (px & 7u);
+            };
+            const std::uint8_t y0 = dc_read8(runtime, src + y_index(x));
+            const std::uint8_t y1 = dc_read8(runtime, src + y_index(x + 1u));
+            const std::size_t out = (dst_base +
+                (static_cast<std::size_t>(mb_y) * 16u + y) * stride_bytes +
+                (static_cast<std::size_t>(mb_x) * 16u + x) * 2u) &
+                (DCRuntime::kVramSize - 1u);
+            runtime.vram[out] = u;
+            runtime.vram[(out + 1u) & (DCRuntime::kVramSize - 1u)] = y0;
+            runtime.vram[(out + 2u) & (DCRuntime::kVramSize - 1u)] = v;
+            runtime.vram[(out + 3u) & (DCRuntime::kVramSize - 1u)] = y1;
+        }
+    }
+}
+
+void pvr_yuv_convert_macroblock_422(DCRuntime& runtime, std::uint32_t src,
+                                    std::size_t dst_base, std::uint32_t mb_index,
+                                    std::uint32_t mb_width) {
+    // YUV422 planar macroblock: U(16x8), V(16x8), Y four 8x8 quadrants.
+    const std::uint32_t mb_x = mb_index % mb_width;
+    const std::uint32_t mb_y = mb_index / mb_width;
+    const std::uint32_t width_px = mb_width * 16u;
+    const std::size_t stride_bytes = static_cast<std::size_t>(width_px) * 2u;
+    for (std::uint32_t y = 0u; y < 16u; ++y) {
+        for (std::uint32_t x = 0u; x < 16u; x += 2u) {
+            const std::uint32_t uv_index = y * 8u + (x >> 1u);
+            const std::uint8_t u = dc_read8(runtime, src + uv_index);
+            const std::uint8_t v = dc_read8(runtime, src + 128u + uv_index);
+            auto y_index = [y](std::uint32_t px) -> std::uint32_t {
+                const std::uint32_t quadrant = (y >= 8u ? 2u : 0u) + (px >= 8u ? 1u : 0u);
+                return 256u + quadrant * 64u + (y & 7u) * 8u + (px & 7u);
+            };
+            const std::uint8_t y0 = dc_read8(runtime, src + y_index(x));
+            const std::uint8_t y1 = dc_read8(runtime, src + y_index(x + 1u));
+            const std::size_t out = (dst_base +
+                (static_cast<std::size_t>(mb_y) * 16u + y) * stride_bytes +
+                (static_cast<std::size_t>(mb_x) * 16u + x) * 2u) &
+                (DCRuntime::kVramSize - 1u);
+            runtime.vram[out] = u;
+            runtime.vram[(out + 1u) & (DCRuntime::kVramSize - 1u)] = y0;
+            runtime.vram[(out + 2u) & (DCRuntime::kVramSize - 1u)] = v;
+            runtime.vram[(out + 3u) & (DCRuntime::kVramSize - 1u)] = y1;
+        }
+    }
+}
