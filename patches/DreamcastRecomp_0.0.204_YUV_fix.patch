+void pvr_yuv_dma_execute(DCRuntime& runtime, std::uint32_t& src, std::uint32_t len) {
+    const auto cfg_it = runtime.mmio32.find(DCRuntime::kPvrRegsPhysicalBase + 0x014Cu);
+    const auto addr_it = runtime.mmio32.find(DCRuntime::kPvrRegsPhysicalBase + 0x0148u);
+    const std::uint32_t cfg = cfg_it == runtime.mmio32.end() ? 0u : cfg_it->second;
+    const std::uint32_t addr = addr_it == runtime.mmio32.end() ? 0u : addr_it->second;
+    const bool input_422 = ((cfg >> 24u) & 1u) != 0u;
+    const std::uint32_t mb_width = (cfg & 0x3Fu) + 1u;
+    const std::uint32_t mb_height = ((cfg >> 8u) & 0x3Fu) + 1u;
+    const std::uint32_t total_mbs = std::max(1u, mb_width * mb_height);
+    const std::uint32_t mb_bytes = input_422 ? 512u : 384u;
+    std::uint32_t converted = runtime.mmio32[DCRuntime::kPvrRegsPhysicalBase + 0x0150u];
+    converted %= total_mbs;
+    const std::size_t dst_base = static_cast<std::size_t>(addr & 0x007FFFFFu);
+    const std::uint32_t full_blocks = len / mb_bytes;
+    const std::uint32_t tail = len % mb_bytes;
+
+    for (std::uint32_t i = 0u; i < full_blocks; ++i) {
+        if (input_422)
+            pvr_yuv_convert_macroblock_422(runtime, src, dst_base, converted, mb_width);
+        else
+            pvr_yuv_convert_macroblock_420(runtime, src, dst_base, converted, mb_width);
+        src += mb_bytes;
+        ++converted;
+        if (converted >= total_mbs) {
+            converted = 0u;
+            holly_raise_event(runtime, 0u, kAsicEventPvrYuvBit);
+        }
+    }
+    // CH2 transfers are 32-byte granular. A partial macroblock is invalid input
+    // to the hardware converter; consume it so DMA state still completes, but
+    // do not fabricate output pixels.
+    src += tail;
+    runtime.mmio32[DCRuntime::kPvrRegsPhysicalBase + 0x0150u] = converted;
+    const std::size_t out_bytes = static_cast<std::size_t>(mb_width) * mb_height * 16u * 16u * 2u;
+    pvr_mark_vram_write(runtime, dst_base, out_bytes);
+}
