+
+std::uint32_t pvr_yuv_to_argb(std::uint8_t y, std::uint8_t u, std::uint8_t v) {
+    // BT.601 studio-range conversion. The PVR stores YUV422 as UYVY and
+    // performs the equivalent conversion while sampling the texture.
+    const int c = std::max(0, static_cast<int>(y) - 16);
+    const int d = static_cast<int>(u) - 128;
+    const int e = static_cast<int>(v) - 128;
+    const std::uint8_t r = pvr_yuv_clamp8((298 * c + 409 * e + 128) >> 8);
+    const std::uint8_t g = pvr_yuv_clamp8((298 * c - 100 * d - 208 * e + 128) >> 8);
+    const std::uint8_t b = pvr_yuv_clamp8((298 * c + 516 * d + 128) >> 8);
+    return 0xFF000000u | (static_cast<std::uint32_t>(r) << 16u) |
+           (static_cast<std::uint32_t>(g) << 8u) | b;
+}
