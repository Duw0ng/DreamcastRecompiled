+  echo Tambien puedes arrastrar el CDI sobre este BAT.
+  pause
+  exit /b 1
+)
+set "DISC=%~f1"
+if not exist "%DISC%" (
+  echo [ERROR] No encuentro "%DISC%"
+  pause
+  exit /b 1
+)
+rem Validate both generated C++ paths before the long commercial compilation.
+call build_windows.bat --no-pause
+if errorlevel 1 goto :failed
+call run_commercial_recompiled.bat "%DISC%"
+set "RC=%ERRORLEVEL%"
+if "%RC%"=="0" exit /b 0
+if "%RC%"=="130" exit /b 130
+goto :report
+:failed
+set "RC=%ERRORLEVEL%"
+:report
+echo [ERROR] Proceso terminado con codigo %RC%. Copia el primer error completo.
+pause
+exit /b %RC%
